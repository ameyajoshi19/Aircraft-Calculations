{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // scripts/check-poh.ts runs under plain Node, which requires explicit
    // file extensions on relative imports.
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
