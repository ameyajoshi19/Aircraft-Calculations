{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // The scripts/ checks run under plain Node, which requires explicit file
    // extensions on relative imports. Set here so scripts/tsconfig.json,
    // which extends this file, inherits it.
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ]
    }
  },
  // scripts/ typechecks separately against Node's types — see scripts/tsconfig.json.
  "exclude": [
    "scripts"
  ],
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
